# Copy to .env and `set -a; source .env; set +a` (or let Render inject these).
ANTHROPIC_API_KEY=sk-ant-...          # required: pays per token, no subscription
DASHBOARD_PASSWORD=change-me          # required in production
SECRET_KEY=any-long-random-string     # signs the login cookie
DATABASE_URL=sqlite:///./studio.db    # or postgresql://user:pass@host/db
SCHEDULER=1                           # 0 to disable the in-process scheduler (use /api/run/<flow> from cron instead)
CRON_TOKEN=                           # bearer token for POST /api/run/<flow>

# LinkedIn auto-publish (optional; without it the kit arrives by email / on the kit page)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email delivery (optional; Gmail: smtp.gmail.com, 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Tests only
# FAKE_LLM=1
